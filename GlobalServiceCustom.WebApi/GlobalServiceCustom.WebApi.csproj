    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- 类库直接引用 kdbin 中的 DLL，不生成或依赖 app.config/bindingRedirect。 -->
